{
  "name": "signflow",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "frontend": "npm --prefix frontend run dev",
    "backend": "py -3.10 -m uvicorn backend.app.main:app --host 127.0.0.1 --port 8000",
    "recognition": "py -3.10 backend/app/recognition/realtime_sentence.py",
    "dev": "concurrently --kill-others-on-fail --names FRONTEND,BACKEND,AI \"npm run frontend\" \"npm run backend\" \"npm run recognition\""
  },
  "devDependencies": {
    "concurrently": "^10.0.5"
  }
}